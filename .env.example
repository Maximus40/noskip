# Copie ce fichier en .env et remplis les valeurs (jamais commité).

# Supabase — Dashboard > Project Settings > API Keys (clé « publishable » sb_publishable_… ou anon).
# Facultatif : sans valeur valide, l'app utilise le projet de production (src/lib/env.ts, PUBLIC_DEFAULTS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In — Google Cloud Console > APIs & Services > Credentials (OAuth client IDs)
# Laisser vide pour masquer le bouton Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Domaine des liens d'invitation universels (https://<domaine>/join/<code>), sans https://.
# Laisser vide tant que le domaine n'est pas configuré : les invitations utilisent noskip://join/<code>.
EXPO_PUBLIC_INVITE_HOST=

# Clé Google Maps SDK for Android (Google Cloud Console > APIs & Services > Credentials).
# Facultative : sans elle, l'app Android dessine un fond de carte stylisé. iOS utilise Apple Plans.
GOOGLE_MAPS_ANDROID_API_KEY=

# EAS project id : déjà fixé dans app.config.ts (@noskip-app/noskip). À remplir seulement pour
# utiliser un autre projet Expo.
EAS_PROJECT_ID=

# RevenueCat (clés SDK publiques, Project settings → API keys) : sans elles, l'écran de paiement
# affiche « paiement pas encore branché ».
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Mentions légales (obligatoires avant publication) : éditeur, contact, URLs publiques.
EXPO_PUBLIC_LEGAL_PUBLISHER=
EXPO_PUBLIC_LEGAL_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
