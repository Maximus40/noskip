    "@react-native-google-signin/google-signin": "^17.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-audio": "~58.0.11",
    "expo-background-task": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^11.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "node --no-warnings scripts/sync-shared.mjs --check && npm run typecheck && npm run typecheck:functions && npm run lint && npm run lint:functions && npm run format:check && npm run test:coverage && npm run test:functions && npm run test:db && npm run simulate:week",
    "test:db": "./scripts/db-test.sh",
    "db:types": "./scripts/db-test.sh --prepare-only && node scripts/gen-db-types.mjs postgresql://postgres@localhost:54329/noskip_test && prettier --write src/lib/database.types.ts",
    "typecheck:functions": "deno check -c supabase/functions/deno.json supabase/functions && deno check --sloppy-imports -c supabase/functions/deno.json scripts/simulate-week.ts",
    "lint:functions": "deno lint -c supabase/functions/deno.json supabase/functions scripts/simulate-week.ts",
    "test:functions": "deno test -c supabase/functions/deno.json --allow-env supabase/functions",
    "qa:visual": "node scripts/visual-qa.mjs",
    "sync:shared": "node --no-warnings scripts/sync-shared.mjs",
    "simulate:week": "./scripts/db-test.sh --prepare-only && deno run --sloppy-imports --allow-run=psql --allow-env --allow-read -c supabase/functions/deno.json scripts/simulate-week.ts"
  },
  "private": true
}
